# Modern spacing adjustments. Lowercase shares these capital glyphs.
languagesystem DFLT dflt;
languagesystem latn dflt;
feature kern {
  pos A V -40;
  pos A W -30;
  pos A Y -40;
  pos F A -25;
  pos L T -35;
  pos L V -25;
  pos L Y -35;
  pos R A 20;
  pos T A -30;
  pos T O -20;
  pos V A -40;
  pos W A -30;
  pos Y A -40;
  pos Y O -20;
} kern;
